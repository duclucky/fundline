TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
FUNDLINE_API_KEY=replace_with_a_long_random_agent_api_key
ARC_DEPLOYER_PRIVATE_KEY=replace_with_testnet_deployer_private_key
ARCSCAN_API_BASE=https://testnet.arcscan.app/api/v2
ARCSCAN_EXPLORER_BASE=https://testnet.arcscan.app
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_NETWORK_NAME=Arc Testnet
ARC_USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
ARC_NATIVE_USDC_DECIMALS=18
ARC_PAYMENT_ROUTER_ADDRESS=
PUBLIC_BASE_URL=https://fundline.example.com # Used for webhook payloads generated without a request context (e.g. overdue job)
CIRCLE_GATEWAY_API_KEY=
# Public Reown (WalletConnect) project id from cloud.reown.com. Public client key,
# not a secret. Enables the "WalletConnect (scan with mobile)" login option; the
# option stays hidden until this is set. Allowlist your domain in the Reown project.
REOWN_PROJECT_ID=
# --- AI workflow runner (v98store) + free-run rate limiting ---
# Master switch. When off (default) the workflow run endpoints are not served and
# the frontend keeps its mock behavior. Turn on to enable live v98store calls.
WORKFLOW_RATE_LIMIT_ENABLED=false
# v98store (OpenAI-compatible) provider. Key is a secret; do not commit a real one.
V98STORE_API_KEY=
V98STORE_BASE_URL=https://v98store.com/v1
# Cost multiplier for the key billing group (Default = 1; read from the v98store dashboard).
V98STORE_GROUP_RATIO=1
# Model used by the build-prompt helper.
WORKFLOW_BUILD_PROMPT_MODEL=gpt-4o-mini
# Free-run quotas per client IP per UTC day, and the spend caps (USD).
WORKFLOW_RUNS_PER_IP_PER_DAY=3
WORKFLOW_GEN_PROMPTS_PER_IP_PER_DAY=3
WORKFLOW_SPEND_PER_IP_PER_DAY_USD=0.50
WORKFLOW_DAILY_BUDGET_USD=10
# Per-API-key (and per x402 payer) caps for authenticated agent runs. Keep the
# per-key spend cap WELL BELOW WORKFLOW_DAILY_BUDGET_USD so one key cannot drain
# the shared global budget (beta pays testnet USDC; v98 cost is real USD).
WORKFLOW_KEY_RUNS_PER_DAY=100
WORKFLOW_KEY_SPEND_PER_DAY_USD=2
# How to read the real client IP: cloudflare | xff | none.
WORKFLOW_TRUST_PROXY=xff
WORKFLOW_BETA_NOTICE=true
# Research workflows do live web search via Tavily (real sources + citations);
# a cheap model then writes the report. Without a key, retrieval falls back to
# paste-your-sources mode. Get a key at tavily.com (has a free tier).
TAVILY_API_KEY=
WORKFLOW_RESEARCH_CHEAP_MODEL=gpt-4o-mini
WORKFLOW_RESEARCH_WRITER_MODEL=gpt-4.1-mini
# CV + Gig Match workflow: JSearch (OpenWeb Ninja) gig API. Freelancer.com and
# Hacker News are free and need no key; JSearch is an on-demand top-up capped
# monthly to stay under the plan. Get a key at openwebninja.com (format ak_...).
JSEARCH_API_KEY=
JSEARCH_MONTHLY_CAP=180
# FundlineRunEscrow (per-run workflow billing, USDC on Arc). Deploy with
# scripts/deploy-fundline-run-escrow.js (needs ARC_DEPLOYER_PRIVATE_KEY +
# ARC_TREASURY_ADDRESS); it writes ARC_RUN_ESCROW_ADDRESS back here.
ARC_TREASURY_ADDRESS=
ARC_RUN_ESCROW_ADDRESS=
# Treasury hot key that signs release/refund (Fundline-controlled, NOT a user key).
# Secret: set in cPanel env only, never commit a real value.
ARC_TREASURY_PRIVATE_KEY=
# --- Circle Gateway (Nanopayments) OPTIONAL parallel payment gate for runs ---
# When on, /run advertises a Circle Gateway batching option alongside on-chain x402
# and escrow: agents pre-fund a Gateway balance once, then pay gas-free per call
# (Circle verifies + settles in batches). Off by default; needs the optional
# @circle-fin/x402-batching dependency installed (lazy-loaded, 503-safe if missing).
# Non-custodial toward the agent; settlement is Circle-intermediated (batched).
WORKFLOW_GATEWAY_ENABLED=false
# Fundline's seller Gateway address (receives settled funds; withdraw to payout later).
# Defaults to ARC_TREASURY_ADDRESS when blank, so workflow revenue consolidates on the
# treasury (whose key Fundline already holds to withdraw). Set only to use a separate ledger.
GATEWAY_SELLER_ADDRESS=
# Circle Gateway API base. Leave blank for the SDK default; testnet is
# https://gateway-api-testnet.circle.com
GATEWAY_API_URL=
# Set true to surface Arc mainnet in the facilitator before public GA.
GATEWAY_ARC_PRIVATE_MAINNET=false

# Circle User-Controlled Wallets (email/social login), an optional wallet option beside the
# external wallets. Off unless WALLET_CIRCLE_ENABLED=true AND CIRCLE_API_KEY is set. Non-custodial:
# the user controls the key via Circle MPC; UCW does NOT use an entity secret. Spec:
# .claude/circle-ucw-wallet-spec.md
WALLET_CIRCLE_ENABLED=false
# Server-only Circle API key (Bearer). Secret. Use a testnet/sandbox key while on Arc testnet.
CIRCLE_API_KEY=
# Public App ID from Console > Wallets > User Controlled > Configurator. Returned in /api/config
# for the Web SDK. Not secret.
CIRCLE_APP_ID=
# Wallet chain + account type. SCA is required for Circle Gas Station (gas sponsorship) on Arc.
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_ACCOUNT_TYPE=SCA
